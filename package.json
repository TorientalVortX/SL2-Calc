{
  "name": "sl2-calculator",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:aether": "vite --host 127.0.0.1 --open /",
    "smoke:aether": "node scripts/aether-smoke.mjs",
    "audit:mobile": "node scripts/aether-mobile-audit.mjs",
    "flow:mobile": "node scripts/aether-mobile-flow.mjs",
    "render:preview": "node scripts/render-social-preview.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "scrape:wiki": "node scripts/scrape-wiki.mjs",
    "scrape:mixtures": "node scripts/refresh-mixtures.mjs",
    "build:skills": "node scripts/build-skill-data.mjs",
    "scrape:races": "node scripts/scrape-races.mjs",
    "scrape:equipment": "node scripts/scrape-equipment.mjs",
    "build:races": "node scripts/build-race-data.mjs",
    "build:armor": "node scripts/build-armor-data.mjs",
    "build:weapons": "node scripts/build-weapon-data.mjs",
    "build:gear": "node scripts/build-gear-data.mjs",
    "build:items": "node scripts/build-item-effects.mjs",
    "build:traits": "node scripts/build-trait-data.mjs",
    "scrape:statuses": "node scripts/scrape-statuses.mjs",
    "build:statuses": "node scripts/build-status-data.mjs",
    "scrape:talents": "node scripts/scrape-talents.mjs",
    "build:talents": "node scripts/build-talent-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run validate:data && npm run typecheck && npm run test",
    "prebuild": "npm run validate:data",
    "build": "vite build",
    "preview": "vite preview",
    "build:sets": "node scripts/build-set-data.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
